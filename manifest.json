{
  "manifest_version": 3,
  "name": "TubeTunes",
  "version": "1.6.1.5",
  "description": "YouTubeのライブラリ・再生リストを音楽プレーヤーとして再生します（モバイル/デスクトップ対応）",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "TubeTunes"
  }
}